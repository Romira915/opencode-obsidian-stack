# syntax=docker/dockerfile:1
FROM nginx:1.27-alpine

RUN apk add --no-cache bash gettext-envsubst

COPY nginx.conf.template /etc/nginx/nginx.conf.template
COPY docker-entrypoint.desktop-bypass-nginx.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Defaults; overridden by docker-compose environment
ENV UPSTREAM_OAUTH2_PROXY=*** UPSTREAM_OPENCHAMBER=http://openchamber:3000

EXPOSE 4181

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
