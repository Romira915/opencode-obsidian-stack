user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    # Docker embedded DNS (127.0.0.11) for upstream host name resolution when
    # $backend is used as a variable (nginx requires an explicit resolver).
    resolver 127.0.0.11 ipv6=off valid=10s;

    # X-Desktop-Token 一致で openchamber 直、不一致で oauth2-proxy
    # 共有秘密 DESKTOP_BYPASS_TOKEN はエントリポイントで envsubst により展開される
    map $http_x_desktop_token $backend {
        default ${UPSTREAM_OAUTH2_PROXY};
        "${DESKTOP_BYPASS_TOKEN}"  ${UPSTREAM_OPENCHAMBER};
    }

    # WebSocket / SSE 用
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 4181;
        server_name _;

        # 共通プロキシ設定
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
        client_max_body_size 100m;

        # 共有秘密を upstream に渡さない (サイドカー内で消費)
        proxy_set_header X-Desktop-Token "";

        location / {
            proxy_pass $backend;
        }
    }
}
