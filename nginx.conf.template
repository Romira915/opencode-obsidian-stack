user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    # Docker embedded DNS (127.0.0.11) for upstream host name resolution when
    # $backend is used as a variable (nginx requires an explicit resolver).
    resolver 127.0.0.11 ipv6=off valid=10s;

    # Desktop Electron の Origin 判定
    # BrowserWindow は常に openchamber-ui://app から SPA を読み込むため、
    # Origin ヘッダが openchamber-ui://app なら Desktop からのリクエストと判定できる
    map $http_origin $is_desktop_origin {
        default 0;
        "openchamber-ui://app"  1;
    }

    # X-Desktop-Token 一致 → 1、不一致 → 0 (curl/test 用)
    map $http_x_desktop_token $token_matched {
        default 0;
        "${DESKTOP_BYPASS_TOKEN}"  1;
    }

    # WebSocket / SSE 用
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    server {
        listen 4181;
        server_name _;

        # 共通プロキシ設定
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
        client_max_body_size 100m;

        # 共有秘密を upstream に渡さない (サイドカー内で消費)
        proxy_set_header X-Desktop-Token "";

        location / {
            set $backend "${UPSTREAM_OAUTH2_PROXY}";

            # CORS プリフライト (OPTIONS) は常に openchamber 直
            if ($request_method = OPTIONS) {
                set $backend "${UPSTREAM_OPENCHAMBER}";
            }

            # Desktop (Electron) からのリクエスト → 常に openchamber 直
            # Origin: openchamber-ui://app は Desktop の BrowserWindow のみが送る。
            # 一般ブラウザはこの Origin を送れない (ブラウザはカスタムスキームを制限する)。
            # openchamber 側の UI_PASSWORD 認証で守られるので、
            # この層で oauth2-proxy を bypass しても実害はない。
            if ($is_desktop_origin) {
                set $backend "${UPSTREAM_OPENCHAMBER}";
            }

            # X-Desktop-Token 一致 → openchamber 直 (curl/test 用)
            if ($token_matched) {
                set $backend "${UPSTREAM_OPENCHAMBER}";
            }

            proxy_pass $backend;
        }
    }
}
