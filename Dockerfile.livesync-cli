FROM node:24-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends git python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN git clone --depth 1 --recurse-submodules https://github.com/vrtmrz/obsidian-livesync.git .
RUN perl -0pi -e 's/const settingsBackup = await fs\.readFile\(settingsPath, "utf-8"\)\.catch\(\(\) => null!\);/const settingsBackup = options.command === "setup" ? null : await fs.readFile(settingsPath, "utf-8").catch(() => null!);/' src/apps/cli/main.ts
RUN npm install --silent
RUN cd src/apps/cli && npm run build

FROM node:24-slim AS runtime-deps

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /deps
COPY --from=builder /build/src/apps/cli/runtime-package.json ./package.json
RUN npm install --omit=dev --silent

FROM node:24-slim

WORKDIR /app
COPY --from=runtime-deps /deps/node_modules ./node_modules
COPY --from=builder /build/src/apps/cli/dist ./dist

ENTRYPOINT ["node", "/app/dist/index.cjs"]
