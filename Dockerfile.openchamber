# syntax=docker/dockerfile:1

FROM oven/bun:1 AS source
ARG OPENCHAMBER_REF=main
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 --branch "$OPENCHAMBER_REF" https://github.com/openchamber/openchamber.git .

FROM oven/bun:1 AS deps
WORKDIR /app
COPY --from=source /src/package.json /src/bun.lock ./
COPY --from=source /src/packages/ui/package.json ./packages/ui/
COPY --from=source /src/packages/web/package.json ./packages/web/
COPY --from=source /src/packages/electron/package.json ./packages/electron/
COPY --from=source /src/packages/vscode/package.json ./packages/vscode/
COPY --from=source /src/bun-patches ./bun-patches
RUN bun install --frozen-lockfile --ignore-scripts

FROM deps AS builder
WORKDIR /app
COPY --from=source /src ./
RUN bun run build:web

FROM oven/bun:1 AS runtime
WORKDIR /home/openchamber

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      git \
      less \
      openssh-client \
      python3 \
      python3-pip \
      python3-venv \
      wget \
      curl \
      sudo \
      xz-utils \
      gcc \
      g++ \
      make \
      pkg-config \
      libssl-dev \
      jq \
      procps \
      htop \
      ripgrep \
      fd-find \
      vim \
      zip \
      unzip \
      dnsutils \
      chromium \
      libnss3 \
      libnspr4 \
      libatk-bridge2.0-0 \
      libdrm2 \
      libxkbcommon0 \
      libgbm1 \
      libasound2 \
      libxcomposite1 \
      libxdamage1 \
      libxrandr2 \
      libpango-1.0-0 \
      libcairo2 \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg | tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/uv \
    && /opt/uv/bin/pip install --no-cache-dir uv \
    && ln -s /opt/uv/bin/uv /usr/local/bin/uv \
    && ln -s /opt/uv/bin/uvx /usr/local/bin/uvx

ARG NODE_VERSION=24.16.0
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) node_arch='x64' ;; \
        arm64) node_arch='arm64' ;; \
        *) echo "Unsupported arch: $arch"; exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" -o /tmp/node.tar.xz; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; \
    rm /tmp/node.tar.xz

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=${CARGO_HOME}/bin:${PATH}
RUN set -eux; \
    curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh; \
    sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal; \
    rm /tmp/rustup-init.sh; \
    rustup --version; \
    cargo --version; \
    cargo install just --locked

ARG UID=1000
ARG GID=1000
# bun user (UID 1000) in the base image conflicts with our desired UID;
# remove it first, then always ensure openchamber group/user exist
RUN (getent passwd "$UID" >/dev/null && userdel -r "$(getent passwd "$UID" | cut -d: -f1)" 2>/dev/null || true) \
    && if ! getent group "$GID" >/dev/null; then groupadd -g "$GID" openchamber; fi \
    && if ! getent passwd openchamber >/dev/null; then useradd -u "$UID" -g "$GID" -m -s /bin/bash openchamber; fi \
    && chown -R "$UID:$GID" /home/openchamber \
    && echo "openchamber ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/openchamber \
    && chmod 440 /etc/sudoers.d/openchamber

USER openchamber

ENV NPM_CONFIG_PREFIX=/home/openchamber/.npm-global
ENV PATH=${NPM_CONFIG_PREFIX}/bin:${PATH}
ENV NODE_ENV=production
# Playwright: use system Chromium instead of downloading its own (ARM-compatible)
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# @playwright/mcp reads its own env vars, not the standard Playwright ones above
ENV PLAYWRIGHT_MCP_EXECUTABLE_PATH=/usr/bin/chromium
ENV PLAYWRIGHT_MCP_BROWSER=chromium

RUN npm config set prefix /home/openchamber/.npm-global \
    && npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && mkdir -p /home/openchamber/.npm-global \
    && mkdir -p /home/openchamber/.local /home/openchamber/.config /home/openchamber/.ssh /home/openchamber/workspaces \
    && npm install -g opencode-ai

COPY --from=cloudflare/cloudflared@sha256:6b599ca3e974349ead3286d178da61d291961182ec3fe9c505e1dd02c8ac31b0 /usr/local/bin/cloudflared /usr/local/bin/cloudflared

COPY --chown=$UID:$GID --from=source /src/scripts/docker-entrypoint.sh /home/openchamber/openchamber-entrypoint.sh
COPY --chown=$UID:$GID --from=deps /app/node_modules ./node_modules
COPY --chown=$UID:$GID --from=deps /app/packages/web/node_modules ./packages/web/node_modules
COPY --chown=$UID:$GID --from=builder /app/package.json ./package.json
COPY --chown=$UID:$GID --from=builder /app/packages/web/package.json ./packages/web/package.json
COPY --chown=$UID:$GID --from=builder /app/packages/web/bin ./packages/web/bin
COPY --chown=$UID:$GID --from=builder /app/packages/web/server ./packages/web/server
COPY --chown=$UID:$GID --from=builder /app/packages/web/dist ./packages/web/dist

EXPOSE 3000

ENTRYPOINT ["sh", "/home/openchamber/openchamber-entrypoint.sh"]
