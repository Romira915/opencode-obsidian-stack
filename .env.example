# --- Access port ---
# Port on which oauth2-proxy listens (host nginx → this port).
OAUTH2_PROXY_PORT=4180

# UI password for OpenChamber's own browser-session auth (2nd factor after Google OAuth).
UI_PASSWORD=change-me

# --- Obsidian vault ---
# Host path to the Obsidian vault synced by Self-hosted LiveSync CLI.
VAULT_PATH=./data/vault

# Git ref used when building OpenChamber from the official repository.
OPENCHAMBER_REF=main

# Host user UID/GID — used to match file ownership on bind-mounted data/.
# Run `id -u` and `id -g` on the host to find yours. Defaults to 1000.
HOST_UID=1000
HOST_GID=1000

# --- Google OAuth (oauth2-proxy) ---
# See setup instructions below.

# Google OAuth client ID (from Google Cloud Console → APIs & Services → Credentials).
OAUTH2_PROXY_CLIENT_ID=change-me

# Google OAuth client secret.
OAUTH2_PROXY_CLIENT_SECRET=change-me

# Cookie signing secret. Generate with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=change-me

# Set to "false" only for local HTTP access; keep "true" for HTTPS (production).
OAUTH2_PROXY_COOKIE_SECURE=true

# The full callback URL that Google redirects to after login.
# Must match one of the "Authorized redirect URIs" in Google Cloud Console.
OAUTH2_PROXY_REDIRECT_URL=http://localhost/oauth2/callback

# Allowed email addresses are defined in ./authenticated-emails.txt (one per line).

# =============================================================================
# Setup for Google OAuth
# =============================================================================
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new OAuth 2.0 Client ID → Web application
# 3. Authorized redirect URIs:
#    - http://localhost/oauth2/callback          (local)
#    - https://your-domain.example.com/oauth2/callback  (production)
# 4. Copy the Client ID and Client Secret into .env above.
# 5. Generate a cookie secret: openssl rand -hex 16
# 6. Add allowed Google account email addresses to authenticated-emails.txt
# 7. Set OAUTH2_PROXY_REDIRECT_URL to the same URL you registered in step 3
